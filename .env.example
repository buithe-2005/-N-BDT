# Sao chép file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env thật.

# --- Backend Node.js ---
PORT=3000
# Để trống JWT_SECRET: hệ thống tự sinh khóa và lưu tại database/.jwt_secret
JWT_SECRET=
JWT_TTL_SECONDS=604800
# Thư mục/ tệp dữ liệu SQLite
DATA_DIR=database
# 1 = nạp dữ liệu DEMO (sản phẩm, tài khoản mẫu) khi CSDL còn trống; 0 = không nạp
SEED_DEMO=1

# --- Quy tắc bán hàng (backend là nguồn có thẩm quyền) ---
SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=2000000
MAX_QTY_PER_LINE=5

# --- Dịch vụ AI (Python) ---
AI_PORT=8001
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=12000
# Khóa kênh nội bộ giữa Python và Node. Hãy đổi khi triển khai thật.
INTERNAL_TOKEN=dev-internal-token-change-me
BACKEND_URL=http://127.0.0.1:3000

# --- Thông tin cửa hàng hiển thị ở chân trang (để trống nếu chưa có) ---
STORE_NAME=STRIDEX
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
STORE_FACEBOOK=
STORE_INSTAGRAM=
STORE_YOUTUBE=
